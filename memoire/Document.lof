\contentsline {figure}{\numberline {5.1}{\ignorespaces Visualisation qualitative du \ac {SDF} de Bernstein pour trois configurations articulaires : gradients $\nabla d$ évalués le long des normales à la surface du robot.\relax }}{74}{figure.caption.58}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Précision de la distance du \ac {SDF} de Bernstein. (a)~Profil de distance le long des normales à la surface du robot ; (b)~distribution de l'erreur signée par rapport à la distance exacte calculée sur les maillages.\relax }}{75}{figure.caption.59}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Qualité du gradient du \ac {SDF} en fonction de la distance à la surface du robot. (a)~Erreur de direction par rapport au gradient exact ; (b)~norme du gradient (propriété eikonale).\relax }}{75}{figure.caption.60}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Temps de calcul de la distance et du gradient : modèle de Bernstein (\ac {GPU}) contre vérité terrain sur maillages (\ac {CPU}), en fonction du nombre de points de requête.\relax }}{76}{figure.caption.61}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Sélection des $K$ points de la carte persistante les plus proches du robot (en rouge) qui contraignent le filtre \ac {CBF} ; l'isosurface $d_{\mathrm {robot}}=1{,}5$~cm forme l'enveloppe de sécurité autour de l'outil (en bleu).\relax }}{77}{figure.caption.62}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Fidélité du planificateur nominal aux démonstrations expertes sur le jeu de validation. (a)~Distribution de la déviation de position (DTW) ; (b)~distribution de l'erreur de rotation finale.\relax }}{78}{figure.caption.63}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Erreur de prédiction en fonction du point $k$ de l'horizon. (a)~Erreur de position ; (b)~erreur de rotation. Bandes : percentiles 10--90 et écart interquartile.\relax }}{79}{figure.caption.64}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Générations multiples du planificateur pour une même observation, superposées à la vérité terrain. (a)~Plan $XY$ ; (b)~plan $XZ$.\relax }}{79}{figure.caption.65}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Intégration du flot pour une scène de la tâche d'alimentation : segment $X_t$ à $t=0$ (bruit), $t=0{,}5$ et $t=1$ (généré), dans les plans $XZ$ (haut) et $YZ$ (bas).\relax }}{80}{figure.caption.66}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces Trajectoire de la pointe de l'outil avec et sans filtre SDF-CBF pour un essai représentatif, superposée au nuage d'obstacles de la carte persistante et à la cible.\relax }}{81}{figure.caption.68}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces Évolution de la barrière $h_{\mathrm {soft}}$ et de sa valeur compensée $h_{\mathrm {corr}}$ pour une tâche en présence d'obstacles; les bandes vertes indiquent les cycles où la projection corrige la vitesse, les bandes jaunes ceux où seule la réparation intervient.\relax }}{82}{figure.caption.70}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces Contrainte de sécurité évaluée sur la vitesse nominale (avant projection) et sur la commande finale (après réparation). Les valeurs négatives de la courbe nominale correspondent aux violations qu'aurait commises la trajectoire générée sans filtre.\relax }}{83}{figure.caption.71}%
\contentsline {figure}{\numberline {5.13}{\ignorespaces Vitesse nominale, correction de projection et vitesse commandée pour chacune des sept articulations.\relax }}{84}{figure.caption.74}%
\contentsline {figure}{\numberline {5.14}{\ignorespaces Taux de variation de la barrière commandé ($\nabla h^\top \dot {\mathbf {q}}_{\mathrm {final}}$) et réellement exécuté ($\nabla h^\top \dot {\mathbf {q}}_{\mathrm {mes}}$) avec l'interface de commande retenue.\relax }}{85}{figure.caption.77}%
