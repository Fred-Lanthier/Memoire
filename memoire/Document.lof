\contentsline {figure}{\numberline {4.1}{\ignorespaces Architecture globale du système asynchrone.\relax }}{32}{figure.caption.14}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Exemple de masque obtenu par le modèle de segmentation \ac {SAM}~3 pour la requête \textit {Pink Block}.\relax }}{35}{figure.caption.15}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Représentation schématique des différents repères du système ($\mathcal {F}_b$ base robot, $\mathcal {F}_c$ caméra à l'effecteur, $\mathcal {F}_e$ \ac {TCP} et $\mathcal {F}_o$ outil/fourchette) intervenant dans les changements de repère et les projections.\relax }}{36}{figure.caption.16}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Principe d'éviction spatiale des voxels de la carte persistante. Chaque voxel du champ de vision est reprojeté le long de son rayon de pixel et sa profondeur est comparée à la mesure : un voxel devant la surface mesurée ($Z_{\text {voxel}} < Z - \delta _{\text {libre}}$) est traversé par le rayon, donc évincé ; un voxel derrière elle ($Z_{\text {voxel}} > Z$) est occulté et conservé, de même qu'un voxel hors du champ de vision.\relax }}{38}{figure.caption.17}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Protocole d'échantillonnage des cibles, vu de dessus dans le repère de base du robot $\mathcal {F}_b$. Les assiettes ($26$~cm de diamètre) se chevauchant, seules trois des neuf positions de la grille $3\times 3$ sont illustrées (supérieur droit, centre, inférieur gauche), le centre de chacune étant marqué par une croix noire. Autour de chaque centre, les $5$ points indiquent les positions de cible en quinconce.\relax }}{39}{figure.caption.18}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Géométrie du filtre de sécurité : (a) champ de distance du lien protégé $l$ et ses bandes de fonctionnement (marge $d_{\mathrm {safe}}$, bande d'activation $h_{\mathrm {act}}$, zone de récupération $d_{\mathrm {rec}}$), où sont évalués les points obstacles observés, le plus proche fixant la barrière ; le gradient spatial $\nabla _{\mathbf {x}} d$, évalué au point, se rabat par la Jacobienne du lien en $\nabla _{\mathbf {q}} h$, qui commande le recul du lien ; (b) second membre saturé $b(h)$ de la contrainte, borné à $-v_{\mathrm {in}}$ en approche et à $+v_{\mathrm {rec}}$ en récupération, et s'annulant à la frontière. Les deux panneaux sont à l'échelle, aux valeurs du Tableau~\ref {tab:cbf_params} : $d_{\mathrm {safe}} = d_{\mathrm {rec}} = 15$~mm, $h_{\mathrm {act}} = 80$~mm et $v_{\mathrm {in}} = v_{\mathrm {rec}} = 0{,}50$~m/s. Les deux plateaux ont donc la même amplitude, mais des pentes distinctes : la récupération est plus de cinq fois plus raide que l'approche, $v_{\mathrm {rec}}/d_{\mathrm {rec}} = 33{,}3$~s$^{-1}$ contre $v_{\mathrm {in}}/h_{\mathrm {act}} = 6{,}25$~s$^{-1}$.\relax }}{53}{figure.caption.20}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Interprétation géométrique, dans un plan de l'espace des vitesses articulaires, de la projection de sécurité~\textup {\hbox {\mathsurround \z@ \normalfont (\ignorespaces \ref {eq:cbf_qp}\unskip \@@italiccorr )}} : la vitesse nominale filtrée $\dot {\mathbf {q}}_{\mathrm {base}}$ est projetée sur l'intersection des demi-espaces actifs $\nabla h_l^\top \dot {\mathbf {q}} \geq r_l$, dont les normales $\nabla h_l$ pointent vers l'intérieur. La solution $\dot {\mathbf {q}}_{\mathrm {proj}}$ est le point où le plus petit ellipsoïde de niveau de la métrique de tâche $\mathbf {W}$ centré sur $\dot {\mathbf {q}}_{\mathrm {base}}$ touche la frontière : la correction $\Delta \dot {\mathbf {q}}_{\mathrm {CBF}}$ suit la direction $\mathbf {W}^{-1}\nabla h_l$ et non la normale, et s'écarte ainsi de la projection euclidienne ($\mathbf {W}=\mathbf {I}$, point creux), en déplaçant le moins possible le lien contrôlé.\relax }}{58}{figure.caption.23}%
\contentsline {figure}{\numberline {5.1}{\ignorespaces Visualisation qualitative du \ac {SDF} de Bernstein pour trois configurations articulaires : gradients $\nabla d$ évalués le long des normales à la surface du robot.\relax }}{70}{figure.caption.33}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Précision de la distance du \ac {SDF} de Bernstein. (a)~Profil de distance le long des normales à la surface du robot ; (b)~distribution de l'erreur signée par rapport à la distance exacte calculée sur les maillages.\relax }}{71}{figure.caption.34}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Qualité du gradient du \ac {SDF} en fonction de la distance à la surface du robot. (a)~Erreur de direction par rapport au gradient exact ; (b)~norme du gradient (propriété eikonale).\relax }}{71}{figure.caption.35}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Temps de calcul de la distance et du gradient : modèle de Bernstein (\ac {GPU}) contre vérité terrain sur maillages (\ac {CPU}), en fonction du nombre de points de requête.\relax }}{73}{figure.caption.36}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Comparaison des quatre conditions sur une même graine du banc de saisie et dépôt (prisme statique). (a)~Trajectoire de la pointe de l'outil dans le plan $yz$, superposée au nuage d'obstacles ; (b)~barrière $h_{\qopname \relax m{min},l}$ au cours de l'essai.\relax }}{83}{figure.caption.46}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Évolution de la barrière $h_{\qopname \relax m{min},l}$ pour une tâche en présence d'obstacles ; les bandes vertes indiquent les cycles où la projection corrige la vitesse, les bandes jaunes ceux où seule la réparation intervient.\relax }}{84}{figure.caption.48}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Contrainte de sécurité évaluée sur la vitesse nominale (avant projection) et sur la commande finale (après réparation). Les valeurs négatives de la courbe nominale correspondent aux violations qu'aurait commises la trajectoire générée sans filtre.\relax }}{85}{figure.caption.49}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Essai représentatif de la tâche de saisie et dépôt en présence du prisme statique. (a)~Barrière $h_{\qopname \relax m{min},l}$, les bandes ombrées marquant les cycles où la vitesse nominale ne satisfait pas la contrainte resserrée ; (b)~norme de la vitesse nominale filtrée, de la commande publiée, de la vitesse articulaire mesurée et de la correction de projection.\relax }}{87}{figure.caption.50}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Ablation de la carte persistante sur une même graine du banc d'alimentation. (a)~Barrière publiée par le n\oe ud ; (b)~barrière exacte recalculée hors ligne sur les maillages. Sans mémoire spatiale, la barrière exacte franchit zéro près de trois secondes avant que la barrière publiée ne le signale.\relax }}{89}{figure.caption.52}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces Calibration de la borne de poursuite $\varepsilon _{\mathrm {p}}$ sur $26$ trajectoires indépendantes de saisie et dépôt. (a)~Fonction de répartition de la perturbation projetée adverse par fenêtre de $10$~ms, selon le régime du frein réflexe : $\varepsilon _{\mathrm {p}}=0{,}025$~rad/s couvre $97{,}9\tmspace +\thinmuskip {.1667em}\%$ des fenêtres d'exécution effective. (b)~Maximum par trajectoire (cercles pleins : tâche complétée ; évidés : plafond de $45$~s atteint) : chaque point agrège ${\sim }2\tmspace +\thinmuskip {.1667em}000$ fenêtres et dépasse donc $\varepsilon _{\mathrm {p}}$ par construction (la queue que le veto absorbe, non un échec de la borne). Les pointillés sont les bornes de prédiction sans hypothèse de distribution (couverture $26/27\approx 0{,}963$) : ce qu'une majoration statique sans surveillance devrait charger dans chaque contrainte pour couvrir une trajectoire entière.\relax }}{95}{figure.caption.56}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces Panda et xArm7 sur une même graine du scénario à prisme statique. (a)~Trajectoire de la pointe de l'outil dans le plan $yz$, superposée au nuage d'obstacles ; (b)~barrière $h_{\qopname \relax m{min},l}$ au cours de l'essai.\relax }}{97}{figure.caption.58}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces Devenir des $255$ essais conduits sous la condition déployée, tous scénarios et tous bancs confondus. Chaque étage retire les essais qui y échouent, dans l'ordre du flux de données : perte de la cible à la perception, condition de sécurité non tenue, blocage ou défaut de progression à la vivacité, puis échecs propres à l'accomplissement de la tâche. La branche de sécurité rassemble les $12$ épisodes où la barrière passe sous zéro ou le résidu de contrainte descend sous le seuil de bruit numérique, dont six accomplissent par ailleurs leur tâche ; aucun essai de la campagne ne produit de collision.\relax }}{105}{figure.caption.72}%
\contentsline {figure}{\numberline {A.1}{\ignorespaces Architecture du système d'acquisition des données d'entraînement.\relax }}{122}{figure.caption.85}%
\contentsline {figure}{\numberline {A.2}{\ignorespaces Structure des dossiers du jeu de données brut.\relax }}{125}{figure.caption.92}%
\contentsline {figure}{\numberline {A.3}{\ignorespaces Structure des dossiers du jeu de données prétraité.\relax }}{126}{figure.caption.93}%
\contentsline {figure}{\numberline {A.4}{\ignorespaces Trois phases de la politique experte simulée pour la tâche d'alimentation.\relax }}{127}{figure.caption.97}%
\contentsline {figure}{\numberline {A.5}{\ignorespaces Trois phases de la politique experte simulée pour la tâche de saisie et dépôt.\relax }}{128}{figure.caption.99}%
\contentsline {figure}{\numberline {B.1}{\ignorespaces Architecture du réseau de vitesse \texttt {ConditionalUnet1D} : encodeur-décodeur 1D à trois niveaux de résolution, connexions de saut et injection du conditionnement global dans chaque bloc résiduel. Chaque triplet indique la forme du tenseur transitant entre les blocs : taille de lot $B$, nombre de canaux, longueur temporelle ($H=16$).\relax }}{133}{figure.caption.110}%
\contentsline {figure}{\numberline {B.2}{\ignorespaces Architecture du bloc résiduel conditionnel (\texttt {ConditionalResidualBlock1D}) du réseau de vitesse, avec sa modulation affine par le conditionnement global. $B$ désigne la taille du lot, $C_{\text {in}}$ et $C_{\text {out}}$ les nombres de canaux à l'entrée et à la sortie du bloc, $H$ la longueur temporelle du niveau de résolution courant et $D_{\text {cond}}=384$ la dimension du conditionnement global $c_g$.\relax }}{134}{figure.caption.111}%
\contentsline {figure}{\numberline {D.1}{\ignorespaces Vérification des rayons normaux. À gauche, le point déplacé le long de la normale conserve son point de départ pour plus proche voisin sur le maillage : sa distance exacte vaut le décalage $\delta $ et le rayon est retenu. À droite, la gorge fait passer le point déplacé au delà de l'axe médian : son plus proche point réel se trouve ailleurs sur le maillage, sa distance exacte est inférieure à $\delta $, et le rayon est rejeté. Sans cette vérification, un tel candidat introduirait une étiquette de distance et une direction toutes deux fausses.\relax }}{140}{figure.caption.123}%
\contentsline {figure}{\numberline {F.1}{\ignorespaces Effondrement de la norme du gradient de contrainte. (a)~Deux points obstacles dominants encadrent le lien et produisent des gradients articulaires de sens opposés. (b)~Leur combinaison convexe par les poids $\omega _i$ du soft-min s'annule presque : la direction résiduelle n'est plus qu'un résidu dominé par le bruit du modèle de distance, et la ligne correspondante est retirée plutôt qu'atténuée.\relax }}{149}{figure.caption.139}%
\contentsline {figure}{\numberline {G.1}{\ignorespaces Caractère unilatéral de la constante du certificat. Les courbes représentent l'évolution de la barrière $h(\mathbf {q}_0+t\tmspace +\thinmuskip {.1667em}\mathbf {d})$ le long du segment parcouru sous bloqueur d'ordre zéro ; la minorante quadratique est la même dans les deux panneaux. (a)~Sous courbure positive, la barrière réelle s'éloigne de la minorante, qui devient inutilement lâche sans jamais être mise en défaut. (b)~Sous courbure négative, la barrière talonne la minorante : c'est ce seul régime que $L_l$ doit couvrir.\relax }}{154}{figure.caption.147}%
\contentsline {figure}{\numberline {I.1}{\ignorespaces Décomposition de la précision du \ac {SDF} de Bernstein et de la direction du gradient pour les neuf corps protégés du robot Panda.\relax }}{161}{figure.caption.162}%
\contentsline {figure}{\numberline {I.2}{\ignorespaces Carte d'erreur géométrique projetée sur l'enveloppe de surface du robot.\relax }}{161}{figure.caption.163}%
\contentsline {figure}{\numberline {I.3}{\ignorespaces Courbes de perte d'entraînement ($\mathcal {L}_{\mathrm {CFM}}$) et de validation en fonction des époques, avec lissage par moyenne mobile exponentielle et sélection du meilleur point de contrôle.\relax }}{162}{figure.caption.166}%
\contentsline {figure}{\numberline {I.4}{\ignorespaces Déviation \ac {DTW} des segments générés et coût de génération en fonction du nombre de pas d'intégration d'Euler $N$. Le temps rapporté est le coût \ac {GPU} synchronisé.\relax }}{163}{figure.caption.168}%
\contentsline {figure}{\numberline {I.5}{\ignorespaces Structure des chemins générés en fonction du nombre de pas d'intégration $N$, comparée aux démonstrations. À gauche, la rugosité du chemin, mesurée par la norme moyenne de la différence seconde le long de l'horizon. À droite, la longueur d'arc générée rapportée à celle de la démonstration correspondante.\relax }}{164}{figure.caption.169}%
\contentsline {figure}{\numberline {I.6}{\ignorespaces Distribution du rapport de rectitude des chemins d'intégration du \textit {Rectified Flow} sur le jeu de validation.\relax }}{165}{figure.caption.171}%
\contentsline {figure}{\numberline {I.7}{\ignorespaces Dispersion inter-générations en fonction du nombre de pas d'intégration $N$, mesurée par la distance \ac {DTW} moyenne entre paires de générations issues d'une même observation.\relax }}{166}{figure.caption.173}%
\contentsline {figure}{\numberline {I.8}{\ignorespaces Générations multiples issues d'une même observation, dans le plan $XY$, pour chaque nombre de pas d'intégration $N$. Les $24$ générations d'un panneau ne diffèrent que par leur tirage initial $X_0$.\relax }}{167}{figure.caption.174}%
\contentsline {figure}{\numberline {I.9}{\ignorespaces Fidélité du planificateur nominal aux démonstrations expertes sur le jeu de validation. (a)~Distribution de la déviation de position (DTW) ; (b)~distribution de l'erreur de rotation finale à l'effecteur.\relax }}{169}{figure.caption.176}%
\contentsline {figure}{\numberline {I.10}{\ignorespaces Erreur de prédiction en fonction du point $k$ de l'horizon. (a)~Erreur de position ; (b)~erreur de rotation. Bandes : percentiles 10--90 et écart interquartile.\relax }}{169}{figure.caption.177}%
\contentsline {figure}{\numberline {I.11}{\ignorespaces Générations multiples du planificateur pour une même observation, superposées à la vérité terrain. (a)~Plan $XY$ ; (b)~plan $XZ$.\relax }}{170}{figure.caption.179}%
\contentsline {figure}{\numberline {I.12}{\ignorespaces Intégration du flot pour une scène de la tâche d'alimentation : segment $X_t$ à $t=0$ (bruit), $t=0{,}5$ et $t=1$ (généré), dans les plans $XZ$ (haut) et $YZ$ (bas).\relax }}{170}{figure.caption.180}%
\contentsline {figure}{\numberline {I.13}{\ignorespaces Sélection des $K$ points de la carte persistante les plus proches du robot (en rouge) qui contraignent le filtre \ac {CBF} ; l'isosurface $d_{\mathrm {robot}}=1{,}5$~cm forme l'enveloppe de sécurité autour de l'outil (en bleu).\relax }}{171}{figure.caption.182}%
\contentsline {figure}{\numberline {I.14}{\ignorespaces Construction de la vitesse nominale pour chacune des sept articulations : feedforward retimé $\dot {q}_{\mathrm {ff}}$, correction de suivi $\dot {q}_{\mathrm {fb}}$ et vitesse nominale filtrée $\dot {q}_{\mathrm {base}}$.\relax }}{172}{figure.caption.185}%
\contentsline {figure}{\numberline {I.15}{\ignorespaces Vitesse nominale, correction de projection, vitesse commandée et vitesse mesurée pour chacune des sept articulations.\relax }}{175}{figure.caption.187}%
\contentsline {figure}{\numberline {I.16}{\ignorespaces Taux de variation de la barrière commandé ($\nabla h^\top \dot {\mathbf {q}}_{\mathrm {final}}$) et réellement exécuté ($\nabla h^\top \dot {\mathbf {q}}_{\mathrm {mes}}$) avec l'interface de commande retenue.\relax }}{177}{figure.caption.190}%
\contentsline {figure}{\numberline {I.17}{\ignorespaces Fidélité du planificateur nominal aux démonstrations expertes pour la tâche de saisie et dépôt. (a)~Distribution de la déviation de position (\ac {DTW}) ; (b)~distribution de l'erreur de rotation finale à l'effecteur.\relax }}{178}{figure.caption.193}%
\contentsline {figure}{\numberline {I.18}{\ignorespaces Erreur de prédiction en fonction du point $k$ de l'horizon pour la tâche de saisie et dépôt. (a)~Erreur de position ; (b)~erreur de rotation. Bandes : percentiles 10 à 90 et écart interquartile.\relax }}{179}{figure.caption.195}%
\contentsline {figure}{\numberline {I.19}{\ignorespaces Générations multiples du planificateur pour une même observation sur la tâche de saisie et dépôt, superposées à la vérité terrain.\relax }}{180}{figure.caption.197}%
\contentsline {figure}{\numberline {I.20}{\ignorespaces Intégration du flot pour une scène de la tâche de saisie et dépôt : segment $X_t$ à $t=0$ (bruit), $t=0{,}5$ et $t=1$ (généré).\relax }}{180}{figure.caption.198}%
