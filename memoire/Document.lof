\contentsline {figure}{\numberline {A.2}{\ignorespaces Structure des dossiers du jeu de données brut.\relax }}{127}{figure.caption.88}%
\contentsline {figure}{\numberline {A.3}{\ignorespaces Structure des dossiers du jeu de données prétraité.\relax }}{128}{figure.caption.89}%
\contentsline {figure}{\numberline {A.4}{\ignorespaces Trois phases de la politique experte simulée pour la tâche d'alimentation.\relax }}{129}{figure.caption.93}%
\contentsline {figure}{\numberline {A.5}{\ignorespaces Trois phases de la politique experte simulée pour la tâche de saisie et dépôt.\relax }}{130}{figure.caption.95}%
\contentsline {figure}{\numberline {B.1}{\ignorespaces Architecture du réseau de vitesse \texttt {ConditionalUnet1D} avec connexions de saut et conditionnement global.\relax }}{135}{figure.caption.106}%
\contentsline {figure}{\numberline {B.2}{\ignorespaces Architecture du bloc résiduel conditionnel (\texttt {ConditionalResidualBlock1D}) et modulation FiLM.\relax }}{136}{figure.caption.107}%
\contentsline {figure}{\numberline {D.1}{\ignorespaces Étiquetage des rayons normaux. À gauche, le point déplacé le long de la normale conserve son point de départ pour plus proche voisin sur le maillage : sa distance exacte vaut le décalage $\delta $ et sa direction, la normale de départ. À droite, la gorge fait passer le point déplacé au-delà de l'axe médian : son plus proche point réel se trouve ailleurs sur le maillage, sa distance exacte est inférieure à $\delta $ et la direction exacte de son gradient, en tirets, s'éloigne de ce point. Les deux rayons sont conservés avec leur cible exacte ; c'est ce second cas qui porte la supervision dans les gorges et le long des arêtes rentrantes.\relax }}{141}{figure.caption.117}%
\contentsline {figure}{\numberline {F.1}{\ignorespaces Dégénérescence et annulation locale de la norme du gradient de contrainte. (a)~Deux points obstacles dominants encadrent le lien et produisent des gradients articulaires de sens opposés. (b)~Leur combinaison convexe par les poids $\omega _i$ du minimum lissé conduit à un gradient de norme inférieure au seuil de tolérance ; la contrainte associée est alors exclue du système de projection afin d'éviter l'injection de bruit cinématique.\relax }}{152}{figure.caption.134}%
\contentsline {figure}{\numberline {G.1}{\ignorespaces Caractère unilatéral de la constante du certificat. Les courbes représentent l'évolution de la barrière $h(\mathbf {q}_0+t\tmspace +\thinmuskip {.1667em}\mathbf {d})$ le long du segment parcouru sous bloqueur d'ordre zéro ; la minorante quadratique est la même dans les deux panneaux. (a)~Sous courbure positive, la barrière réelle s'éloigne de la minorante, qui devient inutilement lâche sans jamais être mise en défaut. (b)~Sous courbure négative, la barrière coïncide avec la minorante : c'est ce seul régime que $L_l$ doit couvrir.\relax }}{158}{figure.caption.141}%
\contentsline {figure}{\numberline {H.1}{\ignorespaces Calibration de la borne de poursuite $\varepsilon _{\mathrm {p}}$ sur 30 trajectoires de saisie et dépôt. (a)~Fonction de répartition de la perturbation projetée ; (b)~perturbation maximale par trajectoire et bornes de prédiction non paramétriques.\relax }}{163}{figure.caption.155}%
\contentsline {figure}{\numberline {I.1}{\ignorespaces Décomposition de la précision du \ac {SDF} de Bernstein et de la direction du gradient pour les neuf corps protégés du robot Panda.\relax }}{166}{figure.caption.160}%
\contentsline {figure}{\numberline {I.2}{\ignorespaces Carte d'erreur géométrique projetée sur l'enveloppe de surface du robot.\relax }}{166}{figure.caption.161}%
\contentsline {figure}{\numberline {I.3}{\ignorespaces Évolution des pertes d'entraînement ($\mathcal {L}_{\mathrm {CFM}}$) et de validation selon les époques.\relax }}{167}{figure.caption.164}%
\contentsline {figure}{\numberline {I.4}{\ignorespaces Qualité et coût de la génération selon le nombre de pas d'Euler $N$. (a)~La déviation \ac {DTW} moyenne demeure pratiquement constante sur toute la plage, son minimum se situant à $N=3$ ; (b)~le temps de génération croît linéairement, à pente constante.\relax }}{168}{figure.caption.166}%
\contentsline {figure}{\numberline {I.5}{\ignorespaces Régularité géométrique du chemin généré selon le nombre de pas d'Euler $N$, comparée aux démonstrations expertes. (a)~Rugosité du chemin, mesurée par la norme de la différence seconde ; (b)~longueur d'arc du chemin généré rapportée à celle de la démonstration. Les deux grandeurs décroissent fortement jusqu'à $N=5$, puis n'évoluent plus qu'à la marge.\relax }}{169}{figure.caption.167}%
\contentsline {figure}{\numberline {I.6}{\ignorespaces Distribution du rapport de rectitude des chemins d'intégration du \textit {Rectified Flow} sur le jeu de validation.\relax }}{170}{figure.caption.169}%
\contentsline {figure}{\numberline {I.7}{\ignorespaces Dispersion inter-générations en fonction du nombre de pas d'intégration $N$.\relax }}{171}{figure.caption.171}%
\contentsline {figure}{\numberline {I.8}{\ignorespaces Trajectoires générées dans le plan $XY$ selon le nombre de pas d'intégration $N$.\relax }}{171}{figure.caption.172}%
\contentsline {figure}{\numberline {I.9}{\ignorespaces Fidélité du planificateur nominal aux démonstrations expertes sur le jeu de validation. (a)~Distribution de la déviation de position (DTW) ; (b)~distribution de l'erreur de rotation finale à l'effecteur.\relax }}{173}{figure.caption.174}%
\contentsline {figure}{\numberline {I.10}{\ignorespaces Évolution du segment $X_t$ durant l'intégration du flot pour la tâche d'alimentation dans les plans $XZ$ et $YZ$.\relax }}{173}{figure.caption.176}%
\contentsline {figure}{\numberline {I.11}{\ignorespaces Sélection des $K$ points d'obstacles critiques et isosurface de sécurité du robot.\relax }}{174}{figure.caption.178}%
\contentsline {figure}{\numberline {I.12}{\ignorespaces Construction de la vitesse nominale pour chacune des sept articulations : consigne anticipatrice réajustée $\dot {q}_{\mathrm {ff}}$, correction de suivi $\dot {q}_{\mathrm {fb}}$ et vitesse nominale filtrée $\dot {q}_{\mathrm {base}}$.\relax }}{175}{figure.caption.181}%
\contentsline {figure}{\numberline {I.13}{\ignorespaces Taux de variation de la barrière commandé ($\nabla h^\top \dot {\mathbf {q}}_{\mathrm {final}}$) et réellement exécuté ($\nabla h^\top \dot {\mathbf {q}}_{\mathrm {mes}}$) avec l'interface de commande retenue.\relax }}{179}{figure.caption.185}%
\contentsline {figure}{\numberline {I.14}{\ignorespaces Fidélité du planificateur nominal aux démonstrations expertes pour la tâche de saisie et dépôt. (a)~Distribution de la déviation de position (\ac {DTW}) ; (b)~distribution de l'erreur de rotation finale à l'effecteur.\relax }}{180}{figure.caption.188}%
\contentsline {figure}{\numberline {I.15}{\ignorespaces Erreur de prédiction en fonction du point $k$ de l'horizon pour la tâche de saisie et dépôt. (a)~Erreur de position ; (b)~erreur de rotation. Bandes : percentiles 10 à 90 et écart interquartile.\relax }}{181}{figure.caption.190}%
\contentsline {figure}{\numberline {I.16}{\ignorespaces Générations multiples du planificateur pour une même observation sur la tâche de saisie et dépôt, superposées à la vérité terrain.\relax }}{182}{figure.caption.192}%
\contentsline {figure}{\numberline {I.17}{\ignorespaces Intégration du flot pour la tâche de saisie et dépôt aux instants $t=0$, $t=0{,}5$ et $t=1$.\relax }}{182}{figure.caption.193}%
\contentsline {figure}{\numberline {I.18}{\ignorespaces Régularité géométrique du chemin généré sur la tâche de saisie et dépôt, selon le nombre de pas d'Euler $N$. (a)~Rugosité du chemin ; (b)~longueur d'arc rapportée à celle de la démonstration.\relax }}{183}{figure.caption.195}%
\contentsline {figure}{\numberline {I.19}{\ignorespaces Qualité et coût de la génération sur la tâche de saisie et dépôt, selon le nombre de pas d'Euler $N$. (a)~La déviation \ac {DTW} moyenne décroît jusqu'à $N=5$ puis se stabilise, contrairement au banc d'alimentation où elle demeure plate ; (b)~le temps d'inférence croît linéairement. Ces durées sont mesurées sans graphe \ac {CUDA} : elles ne se comparent donc pas au compteur \texttt {fm\_generation} du système déployé, qui en utilise un (Section~\ref {sec:res_temps}).\relax }}{184}{figure.caption.196}%
\contentsline {figure}{\numberline {I.20}{\ignorespaces Distribution du rapport de rectitude des chemins d'intégration sur la tâche de saisie et dépôt.\relax }}{184}{figure.caption.197}%
\contentsline {figure}{\numberline {I.21}{\ignorespaces Dispersion inter-générations sur la tâche de saisie et dépôt en fonction du nombre de pas d'intégration $N$.\relax }}{185}{figure.caption.198}%
\contentsline {figure}{\numberline {I.22}{\ignorespaces Trajectoires générées dans le plan $XY$ sur la tâche de saisie et dépôt, selon le nombre de pas d'intégration $N$, pour une même observation et $24$ tirages initiaux.\relax }}{186}{figure.caption.199}%
