\contentsline {figure}{\numberline {2.2}{\ignorespaces Champ de vitesse du \textit {Flow Matching}}}{7}{figure.caption.10}%
\contentsline {figure}{\numberline {4.1}{\ignorespaces Architecture globale du système asynchrone.\relax }}{33}{figure.caption.14}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Exemple de masque obtenu par le modèle de segmentation \ac {SAM}~3 pour la requête \textit {Pink Block}.\relax }}{34}{figure.caption.15}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Repères du système : $\mathcal {F}_b$ pour la base du robot, $\mathcal {F}_c$ pour la caméra à l'effecteur, $\mathcal {F}_e$ pour le \ac {TCP} et $\mathcal {F}_o$ pour l'outil.\relax }}{35}{figure.caption.16}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Principe d'éviction spatiale des voxels. Un voxel qui vérifie $Z_{\text {voxel}} < Z - \delta _{\text {libre}}$ est traversé par le rayon et évincé. Un voxel qui vérifie $Z_{\text {voxel}} > Z$ est occulté et conservé, comme tout voxel hors du champ de vision.\relax }}{37}{figure.caption.17}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Grille d'échantillonnage des cibles et des assiettes dans le repère $\mathcal {F}_b$. La vue de dessus illustre trois des neuf positions de la grille $3\times 3$.\relax }}{38}{figure.caption.18}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Géométrie du filtre de sécurité. Le panneau a représente le régime limite $M_{\mathrm {eff}}\simeq 1$, où la frontière lissée coïncide presque avec $d_{\mathrm {safe}}=15$~mm. Dans le cas général, elle se situe à $d_{\mathrm {safe}}+\alpha \qopname \relax o{log}M_{\mathrm {eff}}$, entre $15$ et $23{,}32$~mm. Les grandeurs $h_{\mathrm {act}}$ et $d_{\mathrm {rec}}$ sont des coordonnées de la barrière lissée. Le panneau b montre le second membre saturé $b(h)$, borné par $v_{\mathrm {in}}=v_{\mathrm {rec}}=0{,}50$~m/s.\relax }}{50}{figure.caption.21}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Projection de sécurité dans un plan des vitesses articulaires. La vitesse $\dot {\mathbf {q}}_{\mathrm {base}}$ est projetée sur les demi-espaces actifs $\nabla h_l^\top \dot {\mathbf {q}} \geq r_l$. Le plus petit ellipsoïde de niveau de $\mathbf {W}$ touche la frontière en $\dot {\mathbf {q}}_{\mathrm {proj}}$. La correction suit $\mathbf {W}^{-1}\nabla h_l$ et perturbe moins le lien contrôlé que la projection euclidienne $\mathbf {W}=\mathbf {I}$ représentée par le point creux.\relax }}{53}{figure.caption.24}%
\contentsline {figure}{\numberline {5.1}{\ignorespaces Visualisation qualitative du \ac {SDF} de Bernstein pour trois configurations articulaires avec les gradients $\nabla d$ évalués le long des normales à la surface du \ac {SDF}.\relax }}{64}{figure.caption.29}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Précision de la distance du \ac {SDF} de Bernstein. Le panneau a présente le profil le long des normales à la surface du robot. Le panneau b présente l'erreur signée par rapport à la distance exacte calculée sur les maillages.\relax }}{64}{figure.caption.30}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Qualité du gradient du \ac {SDF} en fonction de la distance à la surface du robot. Le panneau a présente l'erreur de direction par rapport au gradient exact. Le panneau b présente la norme du gradient et la propriété eikonale.\relax }}{65}{figure.caption.31}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Temps de calcul de la distance en fonction du nombre de points de requête. Le modèle de Bernstein sur \ac {GPU} est comparé aux requêtes de proximité sur les maillages exacts avec \texttt {trimesh} sous \texttt {numpy} et Embree en C++. Le point d'opération du filtre est fixé à $4\tmspace +\thinmuskip {.1667em}096$ points, soit la taille maximale de la carte persistante.\relax }}{67}{figure.caption.32}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Erreur de prédiction du planificateur \ac {FM} le long de l'horizon sur le jeu de validation du banc d'alimentation, avec $200$ fenêtres, $20$ prédictions par fenêtre et $5$ pas d'Euler. Le panneau a présente l'erreur de position et le panneau b l'erreur de rotation à l'effecteur. La médiane et la dispersion croissent avec le rang $k$ du point dans l'horizon.\relax }}{69}{figure.caption.34}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Générations multiples du planificateur pour une même observation du banc d'alimentation, superposées à la vérité terrain et à leur moyenne. Seul le bruit initial varie. Le panneau a présente le plan $XY$ et le panneau b le plan $XZ$.\relax }}{70}{figure.caption.35}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Comparaison des quatre conditions sur une même graine du banc de saisie et dépôt avec le prisme statique. Le panneau a montre la trajectoire de la pointe de l'outil dans le plan $yz$, superposée au nuage d'obstacles. Le panneau b montre la barrière publiée $h_{\mathrm {soft},l}$.\relax }}{77}{figure.caption.42}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Évolution de la barrière publiée $h_{\mathrm {soft},l}$ en présence d'obstacles. Les bandes ombrées indiquent les cycles où la vitesse nominale filtrée $\dot {\mathbf {q}}_{\mathrm {base}}$ ne satisfait pas la contrainte critique.\relax }}{78}{figure.caption.43}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Contrainte de sécurité évaluée sur la vitesse nominale filtrée $\dot {\mathbf {q}}_{\mathrm {base}}$ avant projection et sur la commande publiée $\dot {\mathbf {q}}_{\mathrm {final}}$ après réparation. Les valeurs négatives de la courbe nominale marquent les cycles où $\dot {\mathbf {q}}_{\mathrm {base}}$ ne satisfait pas la contrainte.\relax }}{79}{figure.caption.44}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces Vitesses articulaires du même essai que la Figure~\ref {fig:h_ev}, relevées articulation par articulation : vitesse nominale $\dot {q}_{\mathrm {base}}$, commande publiée $\dot {q}_{\mathrm {final}}$ et vitesse mesurée $\dot {q}_{\mathrm {mes}}$. L'échelle verticale est commune aux sept articulations et les bandes ombrées sont celles de la Figure~\ref {fig:h_ev}.\relax }}{80}{figure.caption.45}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces Décomposition, articulation par articulation, de l'écart $\dot {q}_{\mathrm {final}}-\dot {q}_{\mathrm {base}}$ sur l'essai d'alimentation de la Figure~\ref {fig:h_ev}. Les deux parts sont relevées à chaque cycle selon l'identité~\textup {\hbox {\mathsurround \z@ \normalfont (\ignorespaces \ref {eq:decomp_vitesse}\unskip \@@italiccorr )}}, et leur somme donne la courbe totale. La part du lissage représente la mémoire des corrections antérieures. Les contributions vectorielles peuvent se compenser partiellement.\relax }}{82}{figure.caption.46}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces Évolution de la barrière publiée $h_{\mathrm {soft},l}$ sur un essai représentatif de saisie et dépôt en présence du prisme statique. Les bandes ombrées marquent les cycles où la vitesse nominale filtrée $\dot {\mathbf {q}}_{\mathrm {base}}$ ne satisfait pas la contrainte critique.\relax }}{83}{figure.caption.47}%
\contentsline {figure}{\numberline {5.13}{\ignorespaces Contrainte de sécurité du même essai que la Figure~\ref {fig:pp_deep}, évaluée sur la vitesse nominale filtrée $\dot {\mathbf {q}}_{\mathrm {base}}$ avant projection, puis sur la commande publiée $\dot {\mathbf {q}}_{\mathrm {final}}$ après réparation. Les valeurs négatives de la courbe nominale correspondent aux cycles ombrés de la Figure~\ref {fig:pp_deep}.\relax }}{84}{figure.caption.48}%
\contentsline {figure}{\numberline {5.14}{\ignorespaces Décomposition, articulation par articulation, de l'écart $\dot {q}_{\mathrm {final}}-\dot {q}_{\mathrm {base}}$ sur l'essai de saisie et dépôt de la Figure~\ref {fig:pp_deep}. Les deux parts sont relevées à chaque cycle selon l'identité~\textup {\hbox {\mathsurround \z@ \normalfont (\ignorespaces \ref {eq:decomp_vitesse}\unskip \@@italiccorr )}}, et leur somme donne la courbe totale. La part du lissage représente la mémoire des corrections antérieures. Les contributions vectorielles peuvent se compenser partiellement.\relax }}{85}{figure.caption.49}%
\contentsline {figure}{\numberline {5.15}{\ignorespaces Vitesses articulaires du même essai que la Figure~\ref {fig:pp_deep}, relevées articulation par articulation : vitesse nominale $\dot {q}_{\mathrm {base}}$, commande publiée $\dot {q}_{\mathrm {final}}$ et vitesse mesurée $\dot {q}_{\mathrm {mes}}$. L'échelle verticale est commune aux sept articulations et les bandes ombrées sont celles de la Figure~\ref {fig:pp_deep}.\relax }}{86}{figure.caption.50}%
\contentsline {figure}{\numberline {5.16}{\ignorespaces Ablation de la carte persistante sur le banc d'alimentation. Le panneau a présente la barrière $h_{\mathrm {soft}}$ publiée en ligne. Le panneau b présente la marge géométrique $h_{\mathrm {ex}}$ calculée hors ligne.\relax }}{88}{figure.caption.52}%
\contentsline {figure}{\numberline {5.17}{\ignorespaces Panda et xArm7 sur le même tirage aléatoire du scénario à prisme statique. Le panneau a montre la trajectoire de la pointe de l'outil dans le plan $yz$, superposée au nuage d'obstacles. Le panneau b montre la barrière publiée $h_{\mathrm {soft},l}$.\relax }}{94}{figure.caption.57}%
\contentsline {figure}{\numberline {5.18}{\ignorespaces Répartition des $255$ essais de la configuration déployée. Les anomalies de la chaîne de sécurité regroupent deux signaux $h_{\mathrm {soft}}$ corrompus et un franchissement de la marge géométrique $h_{\mathrm {ex}}=0$, sans contact.\relax }}{102}{figure.caption.72}%
\contentsline {figure}{\numberline {A.1}{\ignorespaces Architecture du système d'acquisition des données d'entraînement.\relax }}{120}{figure.caption.81}%
\contentsline {figure}{\numberline {A.2}{\ignorespaces Structure des dossiers du jeu de données brut.\relax }}{123}{figure.caption.88}%
\contentsline {figure}{\numberline {A.3}{\ignorespaces Structure des dossiers du jeu de données prétraité.\relax }}{124}{figure.caption.89}%
\contentsline {figure}{\numberline {A.4}{\ignorespaces Trois phases de la politique experte simulée pour la tâche d'alimentation.\relax }}{125}{figure.caption.93}%
\contentsline {figure}{\numberline {A.5}{\ignorespaces Trois phases de la politique experte simulée pour la tâche de saisie et dépôt.\relax }}{126}{figure.caption.95}%
\contentsline {figure}{\numberline {B.1}{\ignorespaces Architecture du réseau de vitesse \texttt {ConditionalUnet1D} avec connexions de saut et conditionnement global.\relax }}{131}{figure.caption.106}%
\contentsline {figure}{\numberline {B.2}{\ignorespaces Architecture du bloc résiduel conditionnel (\texttt {ConditionalResidualBlock1D}) et modulation FiLM.\relax }}{132}{figure.caption.107}%
\contentsline {figure}{\numberline {D.1}{\ignorespaces Étiquetage des rayons normaux. À gauche, le point déplacé conserve son point de départ pour plus proche voisin sur le maillage. Sa distance exacte vaut $\delta $ et sa direction de référence suit la normale de départ. À droite, la gorge fait passer le point déplacé au-delà de l'axe médian. Son plus proche point se trouve ailleurs sur le maillage, sa distance exacte est inférieure à $\delta $ et la direction en tirets s'éloigne de ce point. Les deux rayons admissibles sont conservés avec leurs cibles géométriques.\relax }}{137}{figure.caption.117}%
\contentsline {figure}{\numberline {F.1}{\ignorespaces Dégénérescence locale de la norme du gradient de contrainte. Le panneau a montre deux points dominants qui produisent des gradients articulaires de sens opposés. Le panneau b montre leur combinaison convexe, dont la norme passe sous le seuil de tolérance. La contrainte associée est alors exclue du système de projection.\relax }}{147}{figure.caption.134}%
\contentsline {figure}{\numberline {G.1}{\ignorespaces Caractère unilatéral de la constante de courbure. Les courbes représentent $h_{\mathrm {soft}}(\mathbf {q}_0+t\mathbf {d})$ le long du segment parcouru sous bloqueur d'ordre zéro. Le panneau a montre qu'une courbure positive éloigne la barrière de la minorante. Le panneau b illustre le régime de courbure négative que $L_l$ doit couvrir.\relax }}{152}{figure.caption.140}%
\contentsline {figure}{\numberline {H.1}{\ignorespaces Calibration de la borne de poursuite $\varepsilon _{\mathrm p}$ sur 30 trajectoires de saisie et dépôt. Le panneau a montre la fonction de répartition de la perturbation projetée. Le panneau b montre le maximum par trajectoire et les bornes de prédiction non paramétriques.\relax }}{158}{figure.caption.154}%
\contentsline {figure}{\numberline {I.1}{\ignorespaces Décomposition de la précision du \ac {SDF} de Bernstein et de la direction du gradient pour les neuf corps protégés du banc d'alimentation.\relax }}{160}{figure.caption.159}%
\contentsline {figure}{\numberline {I.2}{\ignorespaces Carte d'erreur géométrique projetée sur l'enveloppe de surface du robot.\relax }}{161}{figure.caption.160}%
\contentsline {figure}{\numberline {I.3}{\ignorespaces Évolution de la perte d'entraînement $\mathcal {L}_{\mathrm {CFM}}$ et de la perte de validation selon les époques.\relax }}{161}{figure.caption.163}%
\contentsline {figure}{\numberline {I.4}{\ignorespaces Qualité et coût de la génération selon le nombre de pas d'Euler $N$. Le panneau a montre une déviation \ac {DTW} moyenne peu sensible à $N$, avec un minimum à $N=3$. Le panneau b montre la croissance linéaire du temps de génération.\relax }}{162}{figure.caption.165}%
\contentsline {figure}{\numberline {I.5}{\ignorespaces Régularité géométrique du chemin généré selon le nombre de pas d'Euler $N$. Le panneau a montre la rugosité mesurée par la norme de la différence seconde. Le panneau b montre la longueur d'arc rapportée à celle de la démonstration. Les deux grandeurs décroissent fortement jusqu'à $N=5$.\relax }}{163}{figure.caption.166}%
\contentsline {figure}{\numberline {I.6}{\ignorespaces Distribution du rapport de rectitude des chemins d'intégration du \textit {Rectified Flow} sur le jeu de validation.\relax }}{164}{figure.caption.168}%
\contentsline {figure}{\numberline {I.7}{\ignorespaces Dispersion inter-générations en fonction du nombre de pas d'intégration $N$.\relax }}{165}{figure.caption.170}%
\contentsline {figure}{\numberline {I.8}{\ignorespaces Trajectoires générées dans le plan $XY$ selon le nombre de pas d'intégration $N$.\relax }}{165}{figure.caption.171}%
\contentsline {figure}{\numberline {I.9}{\ignorespaces Fidélité du planificateur nominal aux démonstrations expertes sur le jeu de validation. Le panneau a montre la déviation de position selon la \ac {DTW}. Le panneau b montre l'erreur de rotation finale à l'effecteur.\relax }}{166}{figure.caption.173}%
\contentsline {figure}{\numberline {I.10}{\ignorespaces Évolution du segment $X_t$ durant l'intégration du flot pour la tâche d'alimentation dans les plans $XZ$ et $YZ$.\relax }}{167}{figure.caption.174}%
\contentsline {figure}{\numberline {I.11}{\ignorespaces Sélection des $K$ points d'obstacles critiques et isosurface de la frontière dure apprise $h_{\qopname \relax m{min},\mathrm {SDF}}=0$.\relax }}{167}{figure.caption.176}%
\contentsline {figure}{\numberline {I.12}{\ignorespaces Construction de la vitesse nominale pour chacune des sept articulations : consigne anticipatrice réajustée $\dot {q}_{\mathrm {ff}}$, correction de suivi $\dot {q}_{\mathrm {fb}}$ et vitesse nominale filtrée $\dot {q}_{\mathrm {base}}$.\relax }}{169}{figure.caption.179}%
\contentsline {figure}{\numberline {I.13}{\ignorespaces Taux de variation de la barrière lissée sur la commande publiée et sur la vitesse mesurée.\relax }}{171}{figure.caption.183}%
\contentsline {figure}{\numberline {I.14}{\ignorespaces Fidélité du planificateur nominal aux démonstrations expertes pour la tâche de saisie et dépôt. Le panneau a montre la déviation de position selon la \ac {DTW}. Le panneau b montre l'erreur de rotation finale à l'effecteur.\relax }}{172}{figure.caption.186}%
\contentsline {figure}{\numberline {I.15}{\ignorespaces Erreur de prédiction selon le point $k$ de l'horizon pour la tâche de saisie et dépôt. Le panneau a montre l'erreur de position et le panneau b l'erreur de rotation. Les bandes représentent les percentiles 10 à 90 et l'écart interquartile.\relax }}{173}{figure.caption.189}%
\contentsline {figure}{\numberline {I.16}{\ignorespaces Générations multiples du planificateur pour une même observation sur la tâche de saisie et dépôt, superposées à la vérité terrain.\relax }}{174}{figure.caption.191}%
\contentsline {figure}{\numberline {I.17}{\ignorespaces Intégration du flot pour la tâche de saisie et dépôt aux instants $t=0$, $t=0{,}5$ et $t=1$.\relax }}{175}{figure.caption.192}%
\contentsline {figure}{\numberline {I.18}{\ignorespaces Régularité géométrique du chemin généré sur la tâche de saisie et dépôt selon le nombre de pas d'Euler $N$. Le panneau a montre la rugosité et le panneau b la longueur d'arc rapportée à celle de la démonstration.\relax }}{176}{figure.caption.194}%
\contentsline {figure}{\numberline {I.19}{\ignorespaces Qualité et coût de la génération sur la tâche de saisie et dépôt selon le nombre de pas d'Euler $N$. Le panneau a montre la baisse de la déviation \ac {DTW} jusqu'à $N=5$. Le panneau b montre la croissance linéaire du temps d'inférence. Ces durées sont mesurées hors graphe \ac {CUDA} et diffèrent donc du compteur \texttt {fm\_generation} du système déployé selon la Section~\ref {sec:res_temps}.\relax }}{176}{figure.caption.195}%
\contentsline {figure}{\numberline {I.20}{\ignorespaces Distribution du rapport de rectitude des chemins d'intégration sur la tâche de saisie et dépôt.\relax }}{177}{figure.caption.196}%
\contentsline {figure}{\numberline {I.21}{\ignorespaces Dispersion inter-générations sur la tâche de saisie et dépôt en fonction du nombre de pas d'intégration $N$.\relax }}{177}{figure.caption.197}%
\contentsline {figure}{\numberline {I.22}{\ignorespaces Trajectoires générées dans le plan $XY$ sur la tâche de saisie et dépôt, selon le nombre de pas d'intégration $N$, pour une même observation et $24$ tirages initiaux.\relax }}{178}{figure.caption.198}%
