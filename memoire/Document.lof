\contentsline {figure}{\numberline {4.1}{\ignorespaces Architecture globale du système asynchrone.\relax }}{33}{figure.caption.14}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Exemple de masque obtenu par le modèle de segmentation \ac {SAM}~3 pour la requête \textit {Pink Block}.\relax }}{34}{figure.caption.15}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Repères du système : $\mathcal {F}_b$ pour la base du robot, $\mathcal {F}_c$ pour la caméra à l'effecteur, $\mathcal {F}_e$ pour le \ac {TCP} et $\mathcal {F}_o$ pour l'outil.\relax }}{35}{figure.caption.16}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Principe d'éviction spatiale des voxels. Un voxel qui vérifie $Z_{\text {voxel}} < Z - \delta _{\text {libre}}$ est traversé par le rayon et évincé. Un voxel qui vérifie $Z_{\text {voxel}} > Z$ est occulté et conservé, comme tout voxel hors du champ de vision.\relax }}{37}{figure.caption.17}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Grille d'échantillonnage des cibles et des assiettes dans le repère $\mathcal {F}_b$. La vue de dessus illustre trois des neuf positions de la grille $3\times 3$.\relax }}{38}{figure.caption.18}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Géométrie du filtre de sécurité. Le panneau a représente le régime limite $M_{\mathrm {eff}}\simeq 1$, où la frontière lissée coïncide presque avec $d_{\mathrm {safe}}=15$~mm. Dans le cas général, elle se situe à $d_{\mathrm {safe}}+\alpha \qopname \relax o{log}M_{\mathrm {eff}}$, entre $15$ et $23{,}32$~mm. Les grandeurs $h_{\mathrm {act}}$ et $d_{\mathrm {rec}}$ sont des coordonnées de la barrière lissée. Le panneau b montre le second membre saturé $b(h)$, borné par $v_{\mathrm {in}}=v_{\mathrm {rec}}=0{,}50$~m/s.\relax }}{50}{figure.caption.21}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Projection de sécurité dans un plan des vitesses articulaires. La vitesse $\dot {\mathbf {q}}_{\mathrm {base}}$ est projetée sur les demi-espaces actifs $\nabla h_l^\top \dot {\mathbf {q}} \geq r_l$. Le plus petit ellipsoïde de niveau de $\mathbf {W}$ touche la frontière en $\dot {\mathbf {q}}_{\mathrm {proj}}$. La correction suit $\mathbf {W}^{-1}\nabla h_l$ et perturbe moins le lien contrôlé que la projection euclidienne $\mathbf {W}=\mathbf {I}$ représentée par le point creux.\relax }}{53}{figure.caption.24}%
\contentsline {figure}{\numberline {5.1}{\ignorespaces Visualisation qualitative du \ac {SDF} de Bernstein pour trois configurations articulaires avec les gradients $\nabla d$ évalués le long des normales à la surface du \ac {SDF}.\relax }}{64}{figure.caption.29}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Précision de la distance du \ac {SDF} de Bernstein. (a)~Profil de distance le long des normales à la surface du robot ; (b)~distribution de l'erreur signée par rapport à la distance exacte calculée sur les maillages.\relax }}{65}{figure.caption.30}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Qualité du gradient du \ac {SDF} en fonction de la distance à la surface du robot. (a)~Erreur de direction par rapport au gradient exact ; (b)~norme du gradient (propriété eikonale).\relax }}{66}{figure.caption.31}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Temps de calcul de la distance en fonction du nombre de points de requête : modèle de Bernstein (\ac {GPU}) contre requêtes de proximité sur les maillages exacts, \texttt {trimesh} (\texttt {numpy}) et Embree (C++). Le point d'opération du filtre est à $4096$ points, taille maximale de la carte persistante.\relax }}{67}{figure.caption.32}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Erreur de prédiction du planificateur \ac {FM} le long de l'horizon, sur le jeu de validation du banc d'alimentation ($200$ fenêtres, $20$ prédictions par fenêtre, $5$ pas d'Euler). (a)~Erreur de position ; (b)~erreur de rotation à l'effecteur. La médiane comme la dispersion croissent avec le rang $k$ du point dans l'horizon, l'incertitude se concentrant en queue de segment.\relax }}{69}{figure.caption.34}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Générations multiples du planificateur pour une même observation du banc d'alimentation, en ne faisant varier que le tirage de bruit initial, superposées à la vérité terrain et à leur moyenne. (a)~Plan $XY$ ; (b)~plan $XZ$.\relax }}{70}{figure.caption.35}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Comparaison des quatre conditions sur une même graine du banc de saisie et dépôt (prisme statique). (a)~Trajectoire de la pointe de l'outil dans le plan $yz$, superposée au nuage d'obstacles ; (b)~barrière $h_{\qopname \relax m{min},l}$ au cours de l'essai.\relax }}{77}{figure.caption.42}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Évolution de la barrière $h_{\qopname \relax m{min},l}$ pour une tâche en présence d'obstacles ; les bandes ombrées indiquent les cycles où la vitesse nominale filtrée $\dot {\mathbf {q}}_{\mathrm {base}}$ viole la contrainte critique.\relax }}{78}{figure.caption.43}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Contrainte de sécurité évaluée sur la vitesse nominale filtrée $\dot {\mathbf {q}}_{\mathrm {base}}$ (avant projection) et sur la commande finale (après réparation). Les valeurs négatives de la courbe nominale marquent les cycles où $\dot {\mathbf {q}}_{\mathrm {base}}$ ne satisfait pas la contrainte.\relax }}{79}{figure.caption.44}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces Vitesses articulaires du même essai que la Figure~\ref {fig:h_ev}, relevées articulation par articulation : vitesse nominale $\dot {q}_{\mathrm {base}}$, commande publiée $\dot {q}_{\mathrm {final}}$ et vitesse mesurée $\dot {q}_{\mathrm {mes}}$. L'échelle verticale est commune aux sept articulations et les bandes ombrées sont celles de la Figure~\ref {fig:h_ev}.\relax }}{80}{figure.caption.45}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces Décomposition, articulation par articulation, de l'écart de la commande à la nominale $\dot {q}_{\mathrm {final}}-\dot {q}_{\mathrm {base}}$ pour le même essai, suivant l'identité~\textup {\hbox {\mathsurround \z@ \normalfont (\ignorespaces \ref {eq:decomp_vitesse}\unskip \@@italiccorr )}}. Les deux parts sont les grandeurs instantanées relevées à chaque cycle, la somme des deux courbes valant exactement la courbe totale. La part du lissage domine parce qu'elle reconduit la correction obtenue aux cycles antérieurs ; elle n'est pas une action d'évitement autonome. Les contributions étant vectorielles, elles peuvent se compenser partiellement.\relax }}{82}{figure.caption.46}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces Essai représentatif de la tâche de saisie et dépôt en présence du prisme statique : évolution de la barrière $h_{\qopname \relax m{min},l}$. Les bandes ombrées marquent les cycles où la contrainte critique, évaluée sur la vitesse nominale filtrée $\dot {\mathbf {q}}_{\mathrm {base}}$, est violée.\relax }}{83}{figure.caption.47}%
\contentsline {figure}{\numberline {5.13}{\ignorespaces Contrainte de sécurité du même essai que la Figure~\ref {fig:pp_deep}, évaluée sur la vitesse nominale filtrée $\dot {\mathbf {q}}_{\mathrm {base}}$ (avant projection) puis sur la commande réellement transmise (après réparation). Les valeurs négatives de la courbe nominale correspondent aux cycles ombrés de la Figure~\ref {fig:pp_deep}.\relax }}{84}{figure.caption.48}%
\contentsline {figure}{\numberline {5.14}{\ignorespaces Décomposition, articulation par articulation, de l'écart de la commande à la nominale $\dot {q}_{\mathrm {final}}-\dot {q}_{\mathrm {base}}$ pour le même essai, suivant l'identité~\textup {\hbox {\mathsurround \z@ \normalfont (\ignorespaces \ref {eq:decomp_vitesse}\unskip \@@italiccorr )}}. Les deux parts sont les grandeurs instantanées relevées à chaque cycle, la somme des deux courbes valant exactement la courbe totale. Comme au banc d'alimentation, la part du lissage domine parce qu'elle reconduit la correction obtenue aux cycles antérieurs ; elle n'est pas une action d'évitement autonome. Les contributions étant vectorielles, elles peuvent se compenser partiellement.\relax }}{85}{figure.caption.49}%
\contentsline {figure}{\numberline {5.15}{\ignorespaces Vitesses articulaires du même essai que la Figure~\ref {fig:pp_deep}, relevées articulation par articulation : vitesse nominale $\dot {q}_{\mathrm {base}}$, commande publiée $\dot {q}_{\mathrm {final}}$ et vitesse mesurée $\dot {q}_{\mathrm {mes}}$. L'échelle verticale est commune aux sept articulations et les bandes ombrées sont celles de la Figure~\ref {fig:pp_deep}.\relax }}{86}{figure.caption.50}%
\contentsline {figure}{\numberline {5.16}{\ignorespaces Ablation de la carte persistante sur le banc d'alimentation. (a)~Barrière publiée en ligne ; (b)~barrière exacte recalculée hors ligne.\relax }}{89}{figure.caption.52}%
\contentsline {figure}{\numberline {5.17}{\ignorespaces Panda et xArm7 sur un même tirage aléatoire du scénario à prisme statique. (a)~Trajectoire de la pointe de l'outil dans le plan $yz$, superposée au nuage d'obstacles ; (b)~barrière $h_{\qopname \relax m{min},l}$ au cours de l'essai.\relax }}{95}{figure.caption.57}%
\contentsline {figure}{\numberline {5.18}{\ignorespaces Diagramme de Sankey de la répartition des 255 essais de la campagne expérimentale selon l'étage de défaillance.\relax }}{104}{figure.caption.72}%
