\contentsline {figure}{\numberline {4.1}{\ignorespaces Architecture globale du système\relax }}{11}{figure.caption.10}%
\contentsline {figure}{\numberline {5.1}{\ignorespaces Précision de la distance du \ac {SDF} de Bernstein. (a)~Profil de distance le long des normales à la surface du robot ; (b)~distribution de l'erreur signée par rapport à la distance exacte calculée sur les maillages.\relax }}{26}{figure.caption.14}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Qualité du gradient du \ac {SDF} en fonction de la distance à la surface du robot. (a)~Erreur de direction par rapport au gradient exact ; (b)~norme du gradient (propriété eikonale).\relax }}{27}{figure.caption.15}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Temps de calcul de la distance et du gradient : modèle de Bernstein (\ac {GPU}) contre vérité terrain sur maillages (\ac {CPU}), en fonction du nombre de points de requête.\relax }}{28}{figure.caption.16}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Sélection des points les plus proches pour contraindre le CBF\relax }}{29}{figure.caption.17}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Évolution de la barrière $h_{\mathrm {soft}}$ et de sa valeur compensée $h_{\mathrm {corr}}$ pour une tâche en présence d'obstacles; les bandes vertes indiquent les cycles où la projection corrige la vitesse, les bandes jaunes ceux où seule la réparation intervient.\relax }}{30}{figure.caption.18}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Contrainte de sécurité évaluée sur la vitesse nominale (avant projection) et sur la commande finale (après réparation). Les valeurs négatives de la courbe nominale correspondent aux violations qu'aurait commises la trajectoire générée sans filtre.\relax }}{31}{figure.caption.19}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Décomposition des vitesses articulaires. (a)~Construction de la vitesse nominale : feedforward retimé à norme constante $\dot {\mathbf {q}}_{\mathrm {ff}}$, correction de suivi $\dot {\mathbf {q}}_{\mathrm {fb}}$ et vitesse nominale filtrée $\dot {\mathbf {q}}_{\mathrm {base}}$. (b)~Action du filtre de sécurité : corrections de projection $\Delta \dot {\mathbf {q}}_{\mathrm {CBF}}$ et de réparation $\Delta \dot {\mathbf {q}}_{\mathrm {rep}}$ (reconstituée par rejeu du filtre de sortie), et vitesse commandée $\dot {\mathbf {q}}_{\mathrm {final}}$. Courbes lissées sur $0{,}25$~s.\relax }}{32}{figure.caption.20}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Action du filtre de sécurité : vitesse nominale et vitesse commandée superposées. Les surfaces teintées, restreintes aux cycles où le filtre intervient (projection ou réparation), distinguent le freinage de la poussée de récupération ; l'écart résiduel non teinté est l'effet du filtre passe-bas de sortie.\relax }}{33}{figure.caption.21}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Norme de la vitesse sécurisée avant et après le filtre passe-bas de sortie ($\tau _{\mathrm {safe}}=0{,}2$~s).\relax }}{34}{figure.caption.22}%
