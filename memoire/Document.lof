\contentsline {figure}{\numberline {4.1}{\ignorespaces Architecture globale du système asynchrone.\relax }}{33}{figure.caption.14}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Exemple de masque obtenu par le modèle de segmentation SAM3 pour le prompt \textit {Pink Block}\relax }}{34}{figure.caption.15}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Représentation schématique des différents repères du système ($\mathcal {F}_b$ base robot, $\mathcal {F}_c$ caméra à l'effecteur, $\mathcal {F}_e$ TCP et $\mathcal {F}_o$ outil/fourchette) intervenant dans les changements de repère et les projections.\relax }}{35}{figure.caption.16}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Principe d'éviction spatiale des voxels de la carte persistante. Chaque voxel du champ de vision est reprojeté le long de son rayon de pixel et sa profondeur est comparée à la mesure : un voxel devant la surface mesurée ($Z_{\text {voxel}} < Z - \delta _{\text {libre}}$) est traversé par le rayon, donc évincé ; un voxel derrière elle ($Z_{\text {voxel}} > Z$) est occulté et conservé, de même qu'un voxel hors du champ de vision.\relax }}{38}{figure.caption.17}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Protocole d'échantillonnage des cibles, vu de dessus dans le repère de base du robot $\mathcal {F}_b$. Les assiettes ($26$~cm de diamètre) se chevauchant, seules trois des neuf positions de la grille $3\times 3$ sont illustrées (supérieur droit, centre, inférieur gauche), le centre de chacune étant marqué par une croix noire. Autour de chaque centre, les $5$ points indiquent les positions de cible en quinconce.\relax }}{39}{figure.caption.18}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Géométrie du filtre de sécurité : (a) champ de distance du lien protégé $l$ et ses bandes de fonctionnement (marge $d_{\mathrm {safe}}$, bande d'activation $h_{\mathrm {act}}$, zone de récupération $d_{\mathrm {rec}}$), où sont évalués les points obstacles observés, le plus proche fixant la barrière ; le gradient spatial $\nabla _{\mathbf {x}} d$, évalué au point, se rabat par la Jacobienne du lien en $\nabla _{\mathbf {q}} h$, qui commande le recul du lien ; (b) second membre saturé $b(h)$ de la contrainte, borné à $-v_{\mathrm {in}}$ en approche et à $+v_{\mathrm {rec}}$ en récupération, avec $b(0)=m_{\mathrm {CBF}}>0$.\relax }}{55}{figure.caption.19}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Interprétation géométrique, dans un plan de l'espace des vitesses articulaires, de la projection de sécurité~\textup {\hbox {\mathsurround \z@ \normalfont (\ignorespaces \ref {eq:cbf_qp}\unskip \@@italiccorr )}} : la vitesse nominale filtrée $\dot {\mathbf {q}}_{\mathrm {base}}$ est projetée sur l'intersection des demi-espaces actifs $\nabla h_l^\top \dot {\mathbf {q}} \geq b(h_l)+\eta _l$, dont les normales $\nabla h_l$ pointent vers l'intérieur. La solution $\dot {\mathbf {q}}_{\mathrm {proj}}$ est le point où le plus petit ellipsoïde de niveau de la métrique de tâche $\mathbf {W}$ centré sur $\dot {\mathbf {q}}_{\mathrm {base}}$ touche la frontière : la correction $\Delta \dot {\mathbf {q}}_{\mathrm {CBF}}$ suit la direction $\mathbf {W}^{-1}\nabla h_l$ et non la normale, et s'écarte ainsi de la projection euclidienne ($\mathbf {W}=\mathbf {I}$, point creux), en déplaçant le moins possible le lien contrôlé.\relax }}{58}{figure.caption.20}%
\contentsline {figure}{\numberline {5.1}{\ignorespaces Visualisation qualitative du \ac {SDF} de Bernstein pour trois configurations articulaires : gradients $\nabla d$ évalués le long des normales à la surface du robot.\relax }}{70}{figure.caption.25}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Précision de la distance du \ac {SDF} de Bernstein. (a)~Profil de distance le long des normales à la surface du robot ; (b)~distribution de l'erreur signée par rapport à la distance exacte calculée sur les maillages.\relax }}{71}{figure.caption.26}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Qualité du gradient du \ac {SDF} en fonction de la distance à la surface du robot. (a)~Erreur de direction par rapport au gradient exact ; (b)~norme du gradient (propriété eikonale).\relax }}{71}{figure.caption.27}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Temps de calcul de la distance et du gradient : modèle de Bernstein (\ac {GPU}) contre vérité terrain sur maillages (\ac {CPU}), en fonction du nombre de points de requête.\relax }}{72}{figure.caption.28}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Sélection des $K$ points de la carte persistante les plus proches du robot (en rouge) qui contraignent le filtre \ac {CBF} ; l'isosurface $d_{\mathrm {robot}}=1{,}5$~cm forme l'enveloppe de sécurité autour de l'outil (en bleu).\relax }}{74}{figure.caption.30}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Fidélité du planificateur nominal aux démonstrations expertes sur le jeu de validation. (a)~Distribution de la déviation de position (DTW) ; (b)~distribution de l'erreur de rotation finale.\relax }}{74}{figure.caption.31}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Erreur de prédiction en fonction du point $k$ de l'horizon. (a)~Erreur de position ; (b)~erreur de rotation. Bandes : percentiles 10--90 et écart interquartile.\relax }}{75}{figure.caption.32}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Générations multiples du planificateur pour une même observation, superposées à la vérité terrain. (a)~Plan $XY$ ; (b)~plan $XZ$.\relax }}{76}{figure.caption.33}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Intégration du flot pour une scène de la tâche d'alimentation : segment $X_t$ à $t=0$ (bruit), $t=0{,}5$ et $t=1$ (généré), dans les plans $XZ$ (haut) et $YZ$ (bas).\relax }}{76}{figure.caption.34}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces Trajectoire de la pointe de l'outil avec et sans filtre \ac {SDF}-\ac {CBF} pour un essai représentatif, superposée au nuage d'obstacles de la carte persistante et à la cible.\relax }}{77}{figure.caption.36}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces Évolution de la barrière $h_{\mathrm {soft}}$ et de sa valeur compensée $h_{\mathrm {corr}}$ pour une tâche en présence d'obstacles; les bandes vertes indiquent les cycles où la projection corrige la vitesse, les bandes jaunes ceux où seule la réparation intervient.\relax }}{78}{figure.caption.38}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces Contrainte de sécurité évaluée sur la vitesse nominale (avant projection) et sur la commande finale (après réparation). Les valeurs négatives de la courbe nominale correspondent aux violations qu'aurait commises la trajectoire générée sans filtre.\relax }}{79}{figure.caption.39}%
\contentsline {figure}{\numberline {5.13}{\ignorespaces Vitesse nominale, correction de projection et vitesse commandée pour chacune des sept articulations.\relax }}{80}{figure.caption.42}%
\contentsline {figure}{\numberline {5.14}{\ignorespaces Taux de variation de la barrière commandé ($\nabla h^\top \dot {\mathbf {q}}_{\mathrm {final}}$) et réellement exécuté ($\nabla h^\top \dot {\mathbf {q}}_{\mathrm {mes}}$) avec l'interface de commande retenue.\relax }}{82}{figure.caption.45}%
